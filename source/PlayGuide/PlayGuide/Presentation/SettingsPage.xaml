<Page x:Class="PlayGuide.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PlayGuide.Presentation"
      xmlns:model="using:PlayGuide.Core.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{StaticResource AppBackgroundBrush}">

  <Grid x:Name="PageRoot"
        utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0"
          Background="{StaticResource HeaderGlowBrush}"
          Padding="28,24,36,12"
          ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Command="{Binding GoBack}"
              ToolTipService.ToolTip="Zurück"
              VerticalAlignment="Center">
        <FontIcon Glyph="&#xE72B;" FontSize="16" />
      </Button>
      <TextBlock Grid.Column="1"
                 Text="Einstellungen"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Style="{StaticResource TitleLargeTextBlockStyle}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="36,16,36,16"
                  Spacing="20"
                  MaxWidth="760"
                  HorizontalAlignment="Stretch">

        <StackPanel Spacing="4">
          <TextBlock Text="Mediatheken"
                     Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Füge Spiele-Mediatheken hinzu. Lasse den Pfad leer, um Steam automatisch zu erkennen."
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Add a Steam library -->
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0"
                   PlaceholderText="Steam-Pfad (leer = automatisch erkennen)"
                   Text="{Binding NewSteamPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1"
                  Style="{StaticResource AccentButtonStyle}"
                  Command="{Binding AddSteamLibrary}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="16" />
              <TextBlock Text="Steam hinzufügen" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Configured sources -->
        <ItemsControl ItemsSource="{Binding Sources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:LibrarySource">
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="16,12"
                      Margin="0,4">
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Grid.Column="0"
                            Glyph="&#xE7FC;"
                            FontSize="22"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Store}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding CustomPath, TargetNullValue='(automatisch erkannt)'}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          ToolTipService.ToolTip="Entfernen"
                          Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.RemoveSource}"
                          CommandParameter="{Binding}">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Actions -->
    <Grid Grid.Row="2"
          Padding="36,12,36,24"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1"
              Content="Zurück"
              Command="{Binding GoBack}" />
      <Button Grid.Column="2"
              Style="{StaticResource AccentButtonStyle}"
              Command="{Binding ScanNow}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="16" />
          <TextBlock Text="Jetzt scannen" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Page>
