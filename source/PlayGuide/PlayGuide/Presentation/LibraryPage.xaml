<Page x:Class="PlayGuide.Presentation.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PlayGuide.Presentation"
      xmlns:conv="using:PlayGuide.Presentation.Converters"
      xmlns:model="using:PlayGuide.Core.Models"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{StaticResource AppBackgroundBrush}">

  <Page.Resources>
    <conv:ArtworkPathConverter x:Key="ArtworkPathConverter" />
  </Page.Resources>

  <Grid x:Name="PageRoot"
        utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Background hero watermark -->
    <Image Grid.RowSpan="3"
           Source="ms-appx:///Assets/controller-hero.png"
           Width="640"
           Height="640"
           Opacity="0.05"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,-80,-120"
           IsHitTestVisible="False" />

    <!-- Header -->
    <Grid Grid.Row="0"
          Background="{StaticResource HeaderGlowBrush}"
          Padding="36,28,36,12"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <FontIcon Grid.Column="0"
                Glyph="&#xE7FC;"
                FontSize="30"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

      <TextBlock Grid.Column="1"
                 Text="PlayGuide"
                 VerticalAlignment="Center"
                 Style="{StaticResource TitleLargeTextBlockStyle}" />

      <Button Grid.Column="2"
              Command="{Binding Refresh}"
              ToolTipService.ToolTip="Bibliothek neu scannen">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="16" />
          <TextBlock Text="Aktualisieren" />
        </StackPanel>
      </Button>

      <Button Grid.Column="3"
              Command="{Binding OpenSettings}"
              ToolTipService.ToolTip="Einstellungen">
        <FontIcon Glyph="&#xE713;" FontSize="16" />
      </Button>
    </Grid>

    <!-- Search -->
    <AutoSuggestBox Grid.Row="1"
                    Margin="36,8,36,12"
                    MaxWidth="520"
                    HorizontalAlignment="Left"
                    PlaceholderText="Spiele durchsuchen…"
                    QueryIcon="Find"
                    Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    <!-- Games -->
    <mvux:FeedView Grid.Row="2"
                   Source="{Binding Games}">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer>
            <GridView ItemsSource="{Binding Data}"
                      Padding="28,8,28,28"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="model:GameEntry">
                  <Button Width="180"
                          Height="290"
                          Margin="10"
                          Style="{StaticResource GameTileButtonStyle}"
                          ToolTipService.ToolTip="{Binding Name}"
                          Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.LaunchGame}"
                          CommandParameter="{Binding}">
                    <Border CornerRadius="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Grid>
                        <!-- Cover art -->
                        <Image Source="{Binding ArtworkPath, Converter={StaticResource ArtworkPathConverter}}"
                               Stretch="UniformToFill" />
                        <!-- Fallback glyph when there is no art (sits behind the image) -->
                        <FontIcon Glyph="&#xE7FC;"
                                  FontSize="48"
                                  Opacity="0.25"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- Scrim + title -->
                        <Border Background="{StaticResource TileScrimBrush}" />
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Bottom"
                                   Margin="12,0,12,12"
                                   Foreground="White"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>

      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16">
            <ProgressRing IsActive="True" Width="56" Height="56" />
            <TextBlock Text="Mediatheken werden durchsucht…"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="420"
                      Spacing="14">
            <FontIcon Glyph="&#xE7FC;"
                      FontSize="64"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Noch keine Spiele"
                       HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Füge in den Einstellungen eine Mediathek hinzu und starte einen Scan."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.OpenSettings}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <TextBlock Text="Einstellungen öffnen" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <TextBlock Text="Beim Laden der Spiele ist ein Fehler aufgetreten."
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
