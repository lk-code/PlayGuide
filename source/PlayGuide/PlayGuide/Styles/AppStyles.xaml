<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Near-black, Xbox-style app background with a faint green tint -->
  <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.4,1">
    <GradientStop Offset="0" Color="#0F1410" />
    <GradientStop Offset="0.55" Color="#0B0E0C" />
    <GradientStop Offset="1" Color="#0E1510" />
  </LinearGradientBrush>

  <!-- Subtle green glow used behind the header -->
  <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#33107C10" />
    <GradientStop Offset="1" Color="#00000000" />
  </LinearGradientBrush>

  <!-- Bottom-up scrim placed over cover art so the title stays readable -->
  <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0.45" Color="#00000000" />
    <GradientStop Offset="1" Color="#E6000000" />
  </LinearGradientBrush>

  <!--
    Game tile: a retemplated Button that scales up on hover/focus and shows an
    accent focus ring (important for controller / keyboard navigation), plus a
    gentle press animation.
  -->
  <Style x:Key="GameTileButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="RootGrid"
                Background="{TemplateBinding Background}"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Accent glow halo (behind the tile) -->
            <Border x:Name="FocusGlow"
                    Margin="-7"
                    CornerRadius="20"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />

            <!-- Crisp accent focus ring -->
            <Border x:Name="FocusBorder"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="4"
                    CornerRadius="14"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>

              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.10" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.10" Duration="0:0:0.15" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
